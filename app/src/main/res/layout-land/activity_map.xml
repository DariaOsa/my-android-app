<?xml version="1.0" encoding="utf-8"?>

<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 🗺️ MAP -->
    <fragment
        android:id="@+id/map"
        android:name="com.google.android.gms.maps.SupportMapFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 🔵 VIEW LIST BUTTON -->
    <Button
        android:id="@+id/btnViewList"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="top|end"
        android:layout_margin="12dp"
        android:text="≡"
        android:textSize="18sp"
        android:textColor="#FFFFFF"
        android:background="@drawable/fab_fake"
        android:elevation="8dp" />

    <!-- 🚀 SEARCH CARD -->
    <LinearLayout
        android:id="@+id/searchCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_margin="12dp"
        android:orientation="vertical"
        android:background="@drawable/ride_card_bg"
        android:elevation="12dp"
        android:padding="16dp">

        <!-- 📍 CURRENT LOCATION -->
        <TextView
            android:id="@+id/txtCurrentLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/getting_location"
            android:textSize="14sp"
            android:textColor="#666666"
            android:paddingBottom="8dp"/>

        <!-- 🔍 DESTINATION -->
        <EditText
            android:id="@+id/edtDestination"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/where_to"
            android:background="@android:color/transparent"
            android:textSize="18sp"
            android:padding="8dp"/>

        <!-- ✅ CONFIRM -->
        <Button
            android:id="@+id/btnConfirmDestination"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/confirm_destination"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:background="#2196F3"
            android:layout_marginTop="8dp"/>

    </LinearLayout>

    <!-- 🚗 RIDE OVERLAY -->
    <LinearLayout
        android:id="@+id/rideOverlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_margin="12dp"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="@drawable/ride_card_bg"
        android:elevation="16dp"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:id="@+id/txtRideInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ride_in_progress"
            android:textColor="#000000"
            android:textSize="18sp"
            android:textStyle="bold"/>

        <Space
            android:layout_width="match_parent"
            android:layout_height="12dp"/>

        <Button
            android:id="@+id/btnEndRide"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/end_ride"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:background="@drawable/btn_danger"/>
    </LinearLayout>

    <!-- 👤 PROFILE -->
    <ImageButton
        android:id="@+id/btnProfile"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="bottom|start"
        android:layout_margin="12dp"
        android:background="@drawable/fab_fake"
        android:src="@drawable/ic_profile"
        android:padding="12dp"
        android:elevation="20dp"
        android:contentDescription="@string/profile"/>

</FrameLayout>